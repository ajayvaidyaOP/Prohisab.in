# Copy to backend/.env only for real MySQL. `npm run dev` needs no .env.
# URL-encode special characters in passwords (@ -> %40, # -> %23).
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/depositin"
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
# Comma-separated frontend origins only if hosting frontend on a separate domain.
ALLOWED_ORIGINS=

# Created ONLY on first setup when there is no admin; never resets an existing admin.
ADMIN_NAME=admin
ADMIN_PASSWORD=

# Stable secret for keyed lookup of staff PIN hashes. REQUIRED (32+ chars) in production.
# Changing it makes existing hashed PINs unusable until the admin resets them.
PIN_PEPPER=
