# Copy this file to backend/.env and fill in YOUR values. Never commit backend/.env.
# Placeholders only. Do not paste real passwords into this example file.

# MySQL connection (MySQL 8.0+ recommended; MySQL 5.7 also works).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL="mysql://erp_app:ErpApp2026_X9@localhost:3306/erp_ledger"

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Business time zone used for "today", dashboard totals and default entry dates
APP_TIMEZONE=Asia/Kolkata

# Sessions
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Cookies: set to true when served over HTTPS (production). Required for Secure cookies.
COOKIE_SECURE=false
# Set to 1 (or the number of proxies) only when behind a trusted reverse proxy
TRUST_PROXY=0

# Where the built frontend lives (production). Relative to backend/.
FRONTEND_DIST=../frontend/dist

# Used ONLY by `npm run seed` in non-interactive mode. Leave blank to be prompted.
ADMIN_USERNAME=
ADMIN_PASSWORD=
