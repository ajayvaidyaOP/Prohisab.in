# Copy this file to backend/.env and fill in YOUR values. Never commit backend/.env.
# Placeholders only. Do not paste real production passwords into this example file.

# MySQL connection (MySQL 8.0+ recommended; MySQL 5.7 / XAMPP / MariaDB / Aiven / TiDB also work).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# - Local MySQL (root user):   mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/erp_ledger
# - XAMPP (no root password):  mysql://root:@localhost:3306/erp_ledger
# - URL-encode special characters in the password (e.g. @ becomes %40, # becomes %23).
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/erp_ledger"

# Set to true when connecting to cloud MySQL over SSL (Aiven, TiDB Cloud, Railway, PlanetScale)
DB_SSL=false

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Business time zone used for "today", dashboard totals and default entry dates
APP_TIMEZONE=Asia/Kolkata

# Sessions
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Cookies: set to true when served over HTTPS (production). Required for Secure cookies.
COOKIE_SECURE=false
# Set to 1 (or true) when deployed behind a reverse proxy (Render, Railway, Nginx, Caddy)
TRUST_PROXY=0

# Optional: Frontend URL when deploying Frontend (Vercel/Netlify) and Backend (Render/Railway) separately.
# Example: CORS_ORIGIN="https://your-frontend.vercel.app"
CORS_ORIGIN=

# Where the built frontend lives (production single-server mode). Relative to backend/.
FRONTEND_DIST=../frontend/dist

# Default Admin credentials used by `npm run db:setup` or `npm run seed` (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
