# Copy this file to backend/.env and fill in YOUR values. Never commit backend/.env.
# Placeholders only. Do not paste real production passwords into this example file.
# `npm run dev:backend` / `npm run dev` load this file into the backend process environment.

# MySQL connection (MySQL 8.0+ recommended; MariaDB / XAMPP also work).
# Create the database first:
#   CREATE DATABASE depositin CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_URL=jdbc:mysql://localhost:3306/depositin?useSSL=false&serverTimezone=Asia/Kolkata
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# HTTP port
PORT=8080

# Business time zone used for "today", dashboard totals and default entry dates
APP_TIMEZONE=Asia/Kolkata

# Sessions
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Cookies: set to true when served over HTTPS (production). Required for Secure cookies.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# Set to true when deployed behind a reverse proxy (Nginx, Caddy, Apache)
TRUST_PROXY=false

# Optional: comma-separated origins when the frontend is hosted separately.
# Leave empty when the frontend and API share one origin (recommended).
ALLOWED_ORIGINS=

# Initial administrator created on first start (change immediately in production!).
# Leave ADMIN_PASSWORD empty to have a random password printed once to the backend log.
ADMIN_NAME=admin
ADMIN_PASSWORD=
